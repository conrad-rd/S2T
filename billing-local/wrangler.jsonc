{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "s2t-credits",
  "account_id": "af3647d66304979b1b3e18be959eeeff",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": "./public", "binding": "ASSETS", "run_worker_first": true},
  "durable_objects": {"bindings": [{"name": "CREDITS", "class_name": "CreditsLedger"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["CreditsLedger"]}],
  "vars": {
    "S2T_BILLING_MODE": "test",
    "S2T_PUBLIC_ORIGIN": "https://s2t-credits.ae-chef-license.workers.dev",
    "CLERK_PUBLISHABLE_KEY": "pk_test_c21hc2hpbmctdHVuYS0xNDkuY2xlcmsuYWNjb3VudHMuZGV2JA"
  },
  "observability": {"enabled": false}
}

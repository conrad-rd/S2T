# Local preview works without any credentials.
S2T_BILLING_MODE=demo
PORT=4317
# For Stripe sandbox, change mode to test and add sandbox secrets locally.
# STRIPE_SECRET_KEY=rk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional Clerk sign-in for local testing. Configure a JWT template named s2t
# with audience s2t-credits and a short lifetime, for example 60 seconds.
# CLERK_PUBLISHABLE_KEY=pk_test_...
# S2T_PUBLIC_ORIGIN=http://localhost:4317
# Real-provider sandbox requires an explicit tester allowlist and the same
# reviewed pricing and external spending caps as live mode. See SETUP.md.
# S2T_STAGING_REAL_PROVIDERS=explicitly-enabled
# S2T_STAGING_USERS=user_...
